# ==========================================
# RAG System Configuration (Qdrant Cloud & Groq)
# ==========================================

# 1. Groq LLM API Configuration
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="openai/gpt-oss-20b"

# 2. Qdrant Cloud Vector Database Configuration
# Obtain from your Qdrant Cloud Dashboard -> Clusters -> Cluster URL & API Keys
QDRANT_URL="https://your-cluster-id.region.gcp.cloud.qdrant.io:6333"
QDRANT_API_KEY="your-qdrant-api-key-here"
QDRANT_COLLECTION="rag_documents_v2"

# 3. Embedding Model (Preserves 384-dimensional HuggingFace model)
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"


